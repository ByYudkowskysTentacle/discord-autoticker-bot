<?xml version="1.0" encoding="UTF-8"?>
<!--
  launchd LaunchAgent for the standalone bot on macOS.

  Install (replace __INSTALL_DIR__ with the folder holding the executable):
    mkdir -p ~/Library/LaunchAgents
    sed "s|__INSTALL_DIR__|$PWD|g" com.autoticker.bot.plist \
        > ~/Library/LaunchAgents/com.autoticker.bot.plist
    launchctl load -w ~/Library/LaunchAgents/com.autoticker.bot.plist

  Stop and remove:
    launchctl unload -w ~/Library/LaunchAgents/com.autoticker.bot.plist

  Logs: tail -f __INSTALL_DIR__/autoticker-bot.log

  This is a LaunchAgent, so it starts when you log in. For a bot that starts
  before any login, move it to /Library/LaunchDaemons and add a <key>UserName</key>
  entry — that needs root.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.autoticker.bot</string>

    <key>ProgramArguments</key>
    <array>
        <string>__INSTALL_DIR__/autoticker-bot</string>
        <string>--log-file</string>
        <string>__INSTALL_DIR__/autoticker-bot.log</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__INSTALL_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <!-- Restart the bot if it exits for any reason. -->
    <key>KeepAlive</key>
    <true/>

    <!-- Wait 30s between restarts so a bad token can't spin the CPU. -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

    <!-- launchd's own capture of stdout/stderr, for failures that happen
         before the bot's file logging is up. -->
    <key>StandardOutPath</key>
    <string>__INSTALL_DIR__/autoticker-bot.launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__INSTALL_DIR__/autoticker-bot.launchd.err.log</string>
</dict>
</plist>
