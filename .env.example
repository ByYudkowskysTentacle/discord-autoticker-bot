# Copy this file to ".env" and fill in your own values.
# Do NOT commit your real .env — it contains secrets.

# ── Required ─────────────────────────────────────────────────────────────
# Your Discord bot token, from the Discord Developer Portal (Bot → Token).
DISCORD_TOKEN=your-discord-bot-token

# Your Finnhub API key, from https://finnhub.io/ (free tier is fine).
FINNHUB_TOKEN=your-finnhub-api-key

# ── Optional ─────────────────────────────────────────────────────────────
# Restrict the bot to a single channel by ID. Leave blank to allow every
# channel the bot can see (and rely on Discord's per-channel permissions).
# To get an ID: enable Developer Mode in Discord, right-click a channel →
# "Copy Channel ID".
ALLOWED_CHANNEL_ID=

# Seconds each user must wait between ticker replies. Set to 0 to disable.
COOLDOWN_SECONDS=10

# Where the bot points users who type "$source". This project is licensed under
# the AGPL-3.0, which requires operators of a MODIFIED version to make their
# source available to users. If you fork and change the bot, set this to YOUR
# fork's public repository URL. Leave blank to use the upstream repository.
SOURCE_URL=
